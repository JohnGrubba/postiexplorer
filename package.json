{
  "name": "postiexplorer",
  "private": true,
  "version": "0.1.0",
  "description": "Modern single-binary PostgreSQL explorer (Tauri v2 + React)",
  "license": "MIT",
  "author": "Jonas Grubbauer",
  "homepage": "https://github.com/JohnGrubba/postiexplorer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnGrubba/postiexplorer.git"
  },
  "bugs": {
    "url": "https://github.com/JohnGrubba/postiexplorer/issues"
  },
  "keywords": ["postgresql", "database", "explorer", "tauri", "sql", "desktop"],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dist": "node scripts/build-release.mjs",
    "test:db": "docker compose up -d && cargo test --test live_db --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
