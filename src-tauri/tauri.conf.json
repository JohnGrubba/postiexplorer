{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PostiExplorer",
  "version": "0.1.1",
  "identifier": "com.postiexplorer.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PostiExplorer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Modern PostgreSQL explorer",
    "longDescription": "Browse schemas, preview table data, and run SQL against PostgreSQL from a single-binary desktop app."
  }
}
